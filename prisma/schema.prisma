generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  name      String?
  createdAt DateTime @default(now())
}

model Order {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  status        OrderStatus  @default(PENDING_WHATSAPP)

  // Customer details (keeping for backward compatibility)
  customerName  String
  customerPhone String
  customerEmail String?
  address       String?
  pincode       String?
  city          String?
  state         String?

  // New user relationship (optional for backward compatibility)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])

  totalAmount   Int
  currency      String       @default("INR")
  notes         String?
  whatsappSent  Boolean      @default(false)
  paymentId     String?      // Razorpay payment ID (pay_xxxxx)
  razorpayOrderId String?    // Razorpay order ID (order_xxxxx)
  paymentMethod String?      // RAZORPAY, WHATSAPP, COD
  items         OrderItem[]
  meta          Json?

  @@index([paymentId])
  @@index([razorpayOrderId])
  @@index([customerPhone])
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  productId String
  title     String
  price     Int
  quantity  Int
  metadata  Json?
}

enum OrderStatus {
  PENDING_WHATSAPP
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  CANCELLED
  SHIPPED
  FULFILLED
}

model Product {
  id                String   @id
  slug              String   @unique
  title             String
  shortDescription  String
  longDescription   String
  price             Int
  currency          String   @default("INR")
  ageRange          String
  coverPath         String
  images            Json
  inventoryQuantity Int
  inventoryStatus   String
  sku               String   @unique
  weightGrams       Int
  dimensionsCm      Json
  pages             Int
  format            String
  author            String
  illustrator       String
  publisher         String
  language          String
  isbn              String
  metaTitle         String
  metaDescription   String
  ogImagePath       String
  twitterCard       String
  hasHeroSlide      Boolean  @default(false)
  heroPriority      Int      @default(0)
  bannerBgPath      String?
  bannerTitle       String?
  bannerSubtitle    String?
  bannerCtaText     String?
  bannerCtaType     String?
  bannerTarget      String?
  bannerAltText     String?
  tags              String[]
  collections       String[]
  isFeatured        Boolean  @default(false)
  published         Boolean  @default(true)
  publishedAt       DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  status            String
  meta              Json?
  amazonUrl         String?  // Amazon product purchase link
}

model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name    String
  email   String
  phone   String?
  subject String?
  message String

  source String?
  meta   Json?

  @@index([createdAt])
  @@index([email])
}

model User {
  id        String   @id @default(cuid())
  mobile    String   @unique
  name      String?
  email     String?
  addresses Json?    // Array of shipping addresses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders      Order[]
  campaignHits CampaignHit[]

  @@index([mobile])
  @@index([createdAt])
}

model CampaignHit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  clickedAt DateTime @default(now())

  @@index([userId])
  @@index([clickedAt])
}

model Lead {
  id         String   @id @default(cuid())
  visitorId  String   @unique  // Links to nv_visitor_id cookie
  phone      String
  name       String?
  source     String?  // "welcome_modal", "checkout", etc.
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  rating      Int      // 1-5 stars
  title       String?
  content     String
  authorName  String
  authorCity  String?
  isVerified  Boolean  @default(false)  // Verified purchase
  isApproved  Boolean  @default(true)   // Admin approval
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

model Testimonial {
  id          String   @id @default(cuid())
  content     String
  authorName  String
  authorTitle String?  // e.g., "Mother of 2", "Preschool Teacher"
  rating      Int      @default(5)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([isActive])
}

model AmazonListing {
  id              String   @id @default(cuid())
  asin            String   @unique
  sku             String?
  title           String
  description     String?
  brand           String?
  price           Float?
  inventoryQty    Int?
  inventoryStatus String?
  rating          Float?
  reviewCount     Int?
  imageUrls       Json?
  bulletPoints    Json?
  keywords        String[]
  listingStatus   String?
  issues          Json?
  rawData         Json?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([asin])
}

model AmazonCampaign {
  id            String   @id @default(cuid())
  campaignId    String   @unique
  name          String
  campaignType  String
  state         String
  dailyBudget   Float
  targetingType String?
  rawData       Json?
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  keywords  AmazonCampaignKeyword[]
  snapshots AmazonMetricSnapshot[]

  @@index([campaignId])
}

model AmazonCampaignKeyword {
  id           String         @id @default(cuid())
  keywordId    String         @unique
  campaign     AmazonCampaign @relation(fields: [campaignId], references: [campaignId])
  campaignId   String
  keywordText  String
  matchType    String
  state        String
  bid          Float?
  lastSyncedAt DateTime       @default(now())

  @@index([campaignId])
  @@index([keywordText])
}

model AmazonMetricSnapshot {
  id         String         @id @default(cuid())
  campaignId String
  campaign   AmazonCampaign @relation(fields: [campaignId], references: [campaignId])
  date       DateTime
  impressions Int           @default(0)
  clicks      Int           @default(0)
  spend       Float         @default(0)
  sales       Float         @default(0)
  orders      Int           @default(0)
  acos        Float?
  roas        Float?
  cpc         Float?
  createdAt   DateTime      @default(now())

  @@unique([campaignId, date])
  @@index([date])
}

model CompetitorAsin {
  id           String    @id @default(cuid())
  asin         String    @unique
  title        String?
  brand        String?
  price        Float?
  rating       Float?
  reviewCount  Int?
  imageUrl     String?
  keywords     String[]
  notes        String?
  rawData      Json?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([asin])
}

model AmazonAdsProfile {
  id          String   @id @default(cuid())
  profileId   String   @unique
  name        String?
  countryCode String?
  timezone    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ListingAnalysis {
  id                String   @id @default(cuid())
  type              String   // "improve" | "create"
  title             String   // human-readable label
  sourceAsin        String?  // listing ASIN being improved (null for "create")
  competitorAsins   String[] // ASINs included in comparison
  uploadedImageUrls String[] // user's uploaded images stored in Supabase
  documentUrl       String?  // Supabase URL of analysis.md
  summary           String?  // first 600 chars for list preview
  status            String   @default("pending") // pending | completed | error
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([sourceAsin])
  @@index([createdAt])
}

model EmailSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  source        String   // activity_kit, newsletter, exit_intent, product_page, blog, coming_soon
  downloadedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([source])
  @@index([createdAt])
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String    // markdown text
  coverImage      String?
  author          String
  tags            String[]
  published       Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
}
